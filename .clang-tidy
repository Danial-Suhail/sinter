# Run by hand: clang-tidy -p build src/codegen/ptx_compiler.cpp
# Needs build/compile_commands.json (CMAKE_EXPORT_COMPILE_COMMANDS is already ON).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  -performance-enum-size,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  readability-container-size-empty,
  readability-redundant-string-init
HeaderFilterRegex: 'include/sinter/.*'
